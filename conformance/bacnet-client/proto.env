# <bacnet-client> (protocols plan row 11), bennu's sample (stock/client-bacnet.xml: one connection to device 1234 at 127.0.0.1:47808,
# command interface on 1330), against a BACnet server beside it in the same network namespace: SERVER=stock (default, bennu's
# sample stock/bacnet-server.xml in the stock image) or SERVER=rust (ours with the module, ff-modbac:22.04). Both run under
# stock/servectl.py so peer.sh can stop and start the server. The client is on port 47809 and the server on 47808 of lo
# (BACNET_IFACE=lo for both: two BACnet/IP stacks in one namespace cannot share a port).
# Judged against one golden, the stock client against the stock server (stock/client-bacnet.golden): the stock client against our
# server (SERVER=rust), and our client against the stock server (DUT=rust). Our client on the stock sample has no tags (an open
# divergence, conformance/README.md) and fails; CFG=conformance/bacnet-client/client-tags.xml (the sample with its tags declared,
# edited) gets as far as its bytes, which still differ. Record the golden: conformance/stock/run-stock.sh bacnet-client
CFG=${CFG:-${here:-/conformance}/stock/client-bacnet.xml}
STOCK_CMD='cd /tmp && LD_LIBRARY_PATH=/usr/local/lib bennu-field-device --f /tmp/cfg.xml'
RUST_DUT_IMAGE=ff-modbac:22.04
DUT_ENV='BACNET_IFACE=lo BACNET_IP_PORT=47809'
case ${SERVER:-stock} in
  rust) SIDE_IMAGE=ff-modbac:22.04; SIDE_BIN=1; srv='env SERVECTL_TERM=1 python3 /tmp/servectl.py 5999 ferrofire field-device --file /tmp/server.xml' ;;
  *)    SIDE_IMAGE=${STOCK_IMAGE:-ffc-stock-2026.11.03:22.04}; srv='env LD_LIBRARY_PATH=/usr/local/lib python3 /tmp/servectl.py 5999 bennu-field-device --f /tmp/server.xml' ;;
esac
SIDE_EXTRA="conformance/stock/servectl.py:/tmp/servectl.py conformance/stock/bacnet-server.xml:/tmp/server.xml"
SIDE_CMD="cd /tmp && BACNET_IFACE=lo BACNET_IP_PORT=47808 $srv > /tmp/servectl.out 2>&1"
WARMUP=3
CAPTURE_FILTER='udp port 47809'
PROTO_FILTER=bacapp
ZEEK_LOAD='icsnpp-bacnet'
