# DNP3 outstation (SPEC 4.2): stock sample config on 127.0.0.1:20000, outstation address 10, master address 1.
CFG=${CFG:-${BENNU_DATA:-}/dnp3-server.xml}
STOCK_CMD='LD_LIBRARY_PATH=/usr/local/lib bennu-field-device --f /tmp/cfg.xml'
WARMUP=4
CAPTURE_FILTER='tcp port 20000'
PROTO_FILTER=dnp3
ZEEK_LOAD='icsnpp-dnp3'
