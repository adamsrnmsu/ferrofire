<?xml version="1.0" encoding="utf-8"?>
<SCEPTRE>
    <field-device>
        <name>rtu-1</name>
        <cycle-time>500</cycle-time>
        <tags>
            <external-tag><name>brkr</name><io>I3</io><type>binary</type></external-tag>
            <external-tag><name>load-power</name><io>I1</io><type>analog</type></external-tag>
            <external-tag><name>load-breaker-toggle</name><io>O0</io><type>binary</type></external-tag>
            <external-tag><name>load-mw-setpoint</name><io>O3</io><type>analog</type></external-tag>
            <external-tag><name>load-mw-direct</name><io>O4</io><type>analog</type></external-tag>
        </tags>
        <comms>
            <dnp3-server>
                <endpoint>tcp://127.0.0.1:20000</endpoint>
                <address>10</address>
                <event-logging>rtu-1-dnp3-outstation.log</event-logging>
                <binary-input><address>2</address><tag>brkr</tag></binary-input>
                <binary-output><address>5</address><tag>load-breaker-toggle</tag></binary-output>
                <analog-input><address>0</address><tag>load-power</tag></analog-input>
                <analog-output><address>1</address><tag>load-mw-setpoint</tag><sbo>1</sbo></analog-output>
                <analog-output><address>2</address><tag>load-mw-direct</tag></analog-output>
            </dnp3-server>
        </comms>
        <input>
            <endpoint>udp://239.0.0.1:40000</endpoint>
            <analog><id>I1</id><name>load-1_bus-1.mw</name></analog>
            <binary><id>I3</id><name>load-1_bus-1.active</name></binary>
        </input>
        <output>
            <endpoint>tcp://127.0.0.1:5555</endpoint>
            <binary><id>O0</id><name>load-1_bus-1.active</name></binary>
            <analog><id>O3</id><name>load-1_bus-1.mw</name></analog>
            <analog><id>O4</id><name>load-1_bus-1.mw.direct</name></analog>
        </output>
    </field-device>
</SCEPTRE>
