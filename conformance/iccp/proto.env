# ICCP / TASE.2 server (not in stock bennu: there is no oracle, so DUT defaults to rust). Independent peers (docker/testpeers): igs-iec-tase2
# and telcon-tase2, both directions (peer.sh, check.sh); the real captures are checked when tests/pcaps/iccp/fetch-real.sh has been run. server.xml is one bilateral-table row (EMS1,
# any address) over a brkr, a load MW, a bus voltage, a command state and a setpoint. There is no open ICCP peer: libiec61850's
# mms_utility (a generic MMS client) browses and reads it, and our own thin client (examples/iccp-client, built by cargo test) does
# the TASE.2 part (write, data set, transfer set, InformationReport); it is copied into the peers container (PEER_BIN).
# Listens on 127.0.0.1:102.
CFG=${CFG:-${here:-/conformance}/${proto:-iccp}/server.xml}
DUT_DEFAULT=rust
DUT_CAPS=''
PEER_BIN=target-linux/debug/examples/iccp-client
STOCK_CMD='echo "bennu has no ICCP server: run with DUT=rust" >&2; exit 2'
WARMUP=4
# the peers' own servers (reverse direction) listen on 10102 (igstase2-server) and 10103 (telcon tase2-server): port 102 is ours
CAPTURE_FILTER='tcp port 102 or tcp port 10102 or tcp port 10103'
TSHARK_EXTRA='-d tcp.port==10102,tpkt -d tcp.port==10103,tpkt'
# repo-relative file:destination copied into the peers container (run.sh): the Wireshark dissector and the Zeek analyzer sources
PEER_EXTRA='tools/wireshark/iccp.lua:/usr/local/share/iccp.lua tools/zeek/iccp:/usr/local/share/zeek-iccp'
PROTO_FILTER='mms'
# peers' own traffic that this Wireshark cannot decode or that ends in a reset: igs sends services-supported bits Wireshark has no name for, and an
# ACSE release (RLRQ) after the MMS Conclude that our stack has already closed on (we FIN after the Conclude response, so its RLRQ meets an RST)
EXPERT_ALLOW='D-SACK|Connection reset|Unknown bit|OID not implemented|zero-byte MMS PDU'
# prepare.sh builds the Spicy analyzer (tools/zeek/iccp) into /tmp/iccp.hlto; ports.zeek attaches it to the peers' ports too
ZEEK_LOAD='/tmp/iccp.hlto /usr/local/share/zeek-iccp/scripts /tmp/ports.zeek'
