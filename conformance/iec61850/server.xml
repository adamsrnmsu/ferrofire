<?xml version="1.0" encoding="utf-8"?>
<SCEPTRE>
    <field-device>
        <name>ied-1</name>
        <cycle-time>500</cycle-time>
        <tags>
            <external-tag><name>brkr</name><io>I3</io><type>binary</type></external-tag>
            <external-tag><name>load-power</name><io>I1</io><type>analog</type></external-tag>
            <external-tag><name>cmd1</name><io>O0</io><type>binary</type></external-tag>
            <external-tag><name>cmd2</name><io>O1</io><type>binary</type></external-tag>
            <external-tag><name>cmd3</name><io>O2</io><type>binary</type></external-tag>
            <external-tag><name>load-mw-setpoint</name><io>O3</io><type>analog</type></external-tag>
        </tags>
        <comms>
            <iec61850-server>
                <endpoint>tcp://127.0.0.1:102</endpoint>
                <event-logging>ied-1-iec61850.log</event-logging>
                <binary-input><tag>brkr</tag></binary-input>
                <analog-input><tag>load-power</tag></analog-input>
                <binary-output><tag>cmd1</tag></binary-output>
                <binary-output><tag>cmd2</tag><sbo>1</sbo></binary-output>
                <binary-output><tag>cmd3</tag></binary-output>
                <analog-output><tag>load-mw-setpoint</tag></analog-output>
                <goose>
                    <interface>lo</interface>
                </goose>
            </iec61850-server>
        </comms>
        <input>
            <endpoint>udp://239.0.0.1:40000</endpoint>
            <analog><id>I1</id><name>load-1_bus-1.mw</name></analog>
            <binary><id>I3</id><name>load-1_bus-1.active</name></binary>
        </input>
        <output>
            <endpoint>tcp://127.0.0.1:5555</endpoint>
            <binary><id>O0</id><name>load-1_bus-1.active</name></binary>
            <binary><id>O1</id><name>load-1_bus-2.active</name></binary>
            <binary><id>O2</id><name>load-1_bus-3.active</name></binary>
            <analog><id>O3</id><name>load-1_bus-1.mw</name></analog>
        </output>
    </field-device>
</SCEPTRE>
