# IEC 61850 server (not in stock bennu: there is no oracle, so DUT defaults to rust). server.xml maps GGIO1.Ind1 (brkr), AnIn1
# (load-power), SPCSO1..3 (SPCSO2 is select-before-operate), APCSO1, and publishes GOOSE (gcbAnalogValues, appid 1000) on lo, which
# is what libiec61850's unmodified example client, control client, reporting client and GOOSE subscriber use.
# Listens on 127.0.0.1:102. GOOSE needs CAP_NET_RAW in the DUT container (DUT_CAPS) and an L2 segment (here: lo).
CFG=${CFG:-${here:-/conformance}/${proto:-iec61850}/server.xml}
DUT_DEFAULT=rust
DUT_CAPS='--cap-add NET_RAW'
STOCK_CMD='echo "bennu has no IEC 61850 server: run with DUT=rust" >&2; exit 2'
WARMUP=4
CAPTURE_FILTER='tcp port 102 or ether proto 0x88b8'
PROTO_FILTER='mms || goose'
EXPERT_ALLOW='D-SACK Sequence'   # a tail-loss-probe retransmission on loopback when a peer is slow to ACK; any other Warn fails
ZEEK_LOAD=''
