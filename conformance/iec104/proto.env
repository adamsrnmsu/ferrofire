# IEC 60870-5-104 server (field-device-spec 4.3, ww-vck): stock/iec104-server.xml (bennu's sample with <subtype> added) probed by
# stock/probe_104x.py; check.sh wants the transcript equal to stock's (stock/iec104-server.golden). SET picks the config and golden:
#   single (default)  the sample, every probe section;
#   double  the sample in double-point mode (stock/server-iec104.xml, also the iec104-client's server), the DUT's TZ five hours off
#           UTC so the M_DP_TB_1 time base shows (stock/iec104-server-double.golden);
#   big     130 more binary and 70 more analog inputs (iec104/server-big.xml), so the interrogation and the periodic report split at
#           the maximum ASDU payload (stock/iec104-server-big.golden).
# bacnet/feed.py runs beside the DUT as its provider: it publishes FEED to the <input> group and logs the writes the commands make;
# peer.sh appends that log to the transcript. Record a golden (DUT=stock): [SET=double|big] conformance/stock/run-stock.sh iec104
SET=${SET:-single}
case $SET in
  double) CFG=${CFG:-${here:-/conformance}/stock/server-iec104.xml}; DUT_ENV='TZ=XST5' ;;
  big)    CFG=${CFG:-${here:-/conformance}/iec104/server-big.xml} ;;
  *)      CFG=${CFG:-${here:-/conformance}/stock/iec104-server.xml} ;;
esac
STOCK_CMD='cd /tmp && LD_LIBRARY_PATH=/usr/local/lib bennu-field-device --f /tmp/cfg.xml'
FEED='bus-1.gen_mw:300.7,load-1_bus-1.mw:250.5,generator-1_bus-1.active:true,load-1_bus-1.active:false,'
DUT_EXTRA="conformance/bacnet/feed.py:/tmp/feed.py"
DUT_PRE="python3 /tmp/feed.py /tmp/provider.log '$FEED' > /tmp/feed.out 2>&1"
PEER_FLAGS="-e SET=$SET"
WARMUP=5
CAPTURE_FILTER='tcp port 2404'
PROTO_FILTER='iec60870_104'
# the probe's I-frame before STARTDT, its silent connections and the k test end in a close by the server; a TCP D-SACK note
# (a duplicate segment on lo) shows up in some runs
EXPERT_ALLOW='Connection reset|Connection finish|D-SACK'
ZEEK_LOAD=''   # the testpeers image has no IEC 104 parser (ICSNPP ships none); Zeek still writes conn.log
