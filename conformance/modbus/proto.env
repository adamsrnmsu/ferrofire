# Modbus/TCP server (SPEC 4.1): server.xml is bennu's own sample modbus-server.xml with the endpoint moved to port 502, the port tshark's
# mbtcp dissector, Zeek's modbus analyzer and nmap's modbus-discover recognise. No provider runs: the peer publishes one RADIO datagram so
# the registers are not all zero (load-1_bus-1.mw 250.5 -> input register 30000 = 16416), and writes only queue.
# Listens on 127.0.0.1:502.
CFG=${CFG:-${here:-/conformance}/${proto:-modbus}/server.xml}
STOCK_CMD='LD_LIBRARY_PATH=/usr/local/lib bennu-field-device --f /tmp/cfg.xml'
WARMUP=4
CAPTURE_FILTER='tcp port 502'
PROTO_FILTER='mbtcp'
ZEEK_LOAD='icsnpp-modbus'
EXPERT_ALLOW='Connection reset'   # nmap and mbpoll end their connections with RST; not the server's doing
