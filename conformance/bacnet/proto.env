# BACnet/IP server (protocols plan row 6): bennu's sample element, conformance/stock/bacnet-server.xml, as stock serves it and as ours
# serves it with the external module (modules/bacnet, image ff-modbac:22.04, docs/modules.md). The device answers Who-Is by broadcast,
# so the probe is another host: run.sh puts the DUT on a private network (OWN_NET) and the peers join it, capturing on eth0.
# feed.py runs beside the DUT as its provider: FEED is published to the <input> group, and the writes that reach the <output> REP
# are logged; peer.sh appends that log to the transcript (stock: conformance/stock/bacnet-server-feed.golden; the provider-less
# stock/bacnet-server.golden is the Task 0b record, re-recorded by stock/run-stock.sh bacnet).
CFG=${CFG:-${here:-/conformance}/stock/bacnet-server.xml}
STOCK_CMD='cd /tmp && BACNET_IFACE=eth0 BACNET_IP_PORT=47808 LD_LIBRARY_PATH=/usr/local/lib bennu-field-device --f /tmp/cfg.xml'
RUST_DUT_IMAGE=ff-modbac:22.04
OWN_NET=1
CAPTURE_IFACE=eth0
FEED='bus-1.gen_mw:300.7,load-1_bus-1.mw:250.5,generator-1_bus-1.active:true,load-1_bus-1.active:true,'
DUT_EXTRA="conformance/bacnet/feed.py:/tmp/feed.py"
DUT_PRE="python3 /tmp/feed.py /tmp/provider.log '$FEED' > /tmp/feed.out 2>&1"
WARMUP=6
CAPTURE_FILTER='udp port 47808'
PROTO_FILTER=bacapp
ZEEK_LOAD='icsnpp-bacnet'
