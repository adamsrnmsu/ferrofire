# The SCORCH providerdata component's runtime, for conformance/elastic/scorch_check.py: Python 3.12 and the dependencies of
# sceptre-phenix-apps (src/python/pyproject.toml). The phenix_apps source itself is copied in at run time, never baked in.
FROM python:3.12-slim
RUN pip install --no-cache-dir "elasticsearch<9" "kafka-python~=2.2.13" "lxml>=6.0.2" "Mako>=1.3.10" minimega "loguru>=0.7.2" \
    "pydantic>=2.0.0" "python-box~=7.2.0" "python-dateutil~=2.9.0" "pyyaml~=6.0.2" "requests>=2.32.4" "rich~=14.2.0" "paramiko>=4.0.0,<5"
