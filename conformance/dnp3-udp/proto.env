# DNP3 outstation on udp:// (ww-8l7, an extra: stock bennu has no UDP channel, so the DUT is ours). server.xml is conformance/dnp3/server.xml
# with the endpoint udp://127.0.0.1:20000; outstation address 10, master address 1. The master is opendnp3's UDP channel (ff-dnp3-master).
CFG=${CFG:-${here:-/conformance}/${proto:-dnp3-udp}/server.xml}
DUT_DEFAULT=rust
STOCK_CMD='false'
WARMUP=4
CAPTURE_FILTER='udp port 20000'
PROTO_FILTER=dnp3
ZEEK_LOAD='icsnpp-dnp3'
