# MQTT client (docs/field-device-protocols-plan.md section 2, Tier 2 row 2): server.xml has two <mqtt-client> elements on the same
# tags, a plain one and a Sparkplug B one, both to a Mosquitto broker on 127.0.0.1:1883. Bennu has no MQTT, so there is no stock oracle
# and DUT defaults to rust. The broker runs in the peers container (peer.sh); the device retries until it is up.
CFG=${CFG:-${here:-/conformance}/${proto:-mqtt}/server.xml}
DUT_DEFAULT=rust
WARMUP=3
CAPTURE_FILTER='tcp port 1883'
PROTO_FILTER='mqtt'
# Zeek's built-in MQTT analyzer (mqtt_connect / mqtt_publish / mqtt_subscribe logs); no ICSNPP package involved
ZEEK_LOAD=''
EXPERT_ALLOW='Connection reset'
# peer.sh kills the device (SIGKILL) to see the will messages, so the peers container needs its process namespace
PEER_FLAGS='--pid container:ff-conf-dut'
