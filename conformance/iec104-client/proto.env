# <iec60870-5-104-client> (protocols plan row 10, ww-vck), bennu's sample (stock/client-iec104.xml, copied unchanged: one connection
# to 127.0.0.1:2404, command interface on 1330), against an IEC 104 server beside it in the same network namespace: SERVER=stock
# (default, stock/server-iec104.xml, the stock/iec104-server.xml sample in double-point mode, so the client's binaries get M_DP_NA_1)
# or SERVER=rust (ours). The server runs under stock/servectl.py so peer.sh can stop and start it, with bacnet/feed.py as its provider.
# The stock client connects once, when it starts, and never again (conformance/iec104/STOCK.md), so the DUT waits on a gate (a
# listener on 5998 that peer.sh connects to once the server is up) before it starts: DUT_ENV puts the wait in front of the DUT
# command, stock's or ours. Judged against one golden, the stock client against the stock server (stock/client-iec104.golden).
# Record it: conformance/stock/run-stock.sh iec104-client
CFG=${CFG:-${here:-/conformance}/stock/client-iec104.xml}
STOCK_CMD='cd /tmp && LD_LIBRARY_PATH=/usr/local/lib bennu-field-device --f /tmp/cfg.xml'
export IEC104_GATE=5998   # the gate's port, here only: exported, so peer.sh (run by inside.sh after it sources this file) has it
DUT_ENV='IEC104_GATE='$IEC104_GATE'; python3 -c "import socket as s; l = s.socket(); l.setsockopt(s.SOL_SOCKET, s.SO_REUSEADDR, 1); l.bind((str(), '$IEC104_GATE')); l.listen(1); c = l.accept()[0]; c.recv(16); c.sendall(bytes([111, 107, 10]))"'
case ${SERVER:-stock} in
  rust) SIDE_BIN=1; srv='env SERVECTL_TERM=1 python3 /tmp/servectl.py 5999 ferrofire field-device --file /tmp/server.xml' ;;
  *)    srv='env LD_LIBRARY_PATH=/usr/local/lib python3 /tmp/servectl.py 5999 bennu-field-device --f /tmp/server.xml' ;;
esac
SIDE_IMAGE=${STOCK_IMAGE:-ffc-stock-2026.11.03:22.04}
FEED='bus-1.gen_mw:300.7,load-1_bus-1.mw:250.5,generator-1_bus-1.active:true,load-1_bus-1.active:false,'
SIDE_EXTRA="conformance/stock/servectl.py:/tmp/servectl.py conformance/stock/server-iec104.xml:/tmp/server.xml conformance/bacnet/feed.py:/tmp/feed.py"
SIDE_CMD="cd /tmp && { python3 /tmp/feed.py /tmp/provider.log '$FEED' > /tmp/feed.out 2>&1 & } && $srv > /tmp/servectl.out 2>&1"
WARMUP=3
CAPTURE_FILTER='tcp port 2404'
PROTO_FILTER='iec60870_104'
EXPERT_ALLOW='Connection reset|Connection finish|D-SACK'   # the server is killed mid-session
ZEEK_LOAD=''   # no IEC 104 parser in the testpeers image
