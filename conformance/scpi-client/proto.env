# <scpi-client> against an instrument we did not write (ww-27o). The DUT is a ferrofire controller (controller.xml): its <scpi-client> has two
# <scpi-client>s polling scpi-parser's example instrument, once over the raw socket (scpi-parser-tcp on 127.0.0.1:5025) and once over VXI-11
# (scpi-parser-vxi11, ONC RPC through rpcbind on 111; both in the testpeers image, BSD-2-Clause, started by peer.sh, ww-5w0), and its own <scpi-server> on 5030 lets the harness set what <logic> sends and read what the controller took from the instrument.
CFG=${CFG:-${here:-/conformance}/${proto:-scpi-client}/controller.xml}
DUT_DEFAULT=rust
# bennu has no SCPI and the binary needs only glibc: the testpeers image is the DUT's base too
RUST_DUT_IMAGE=${RUST_DUT_IMAGE:-ferrofire-testpeers}
WARMUP=2
CAPTURE_FILTER='tcp or udp port 111'
PROTO_FILTER='tcp.port == 5025 || portmap'
# the controller's connect attempts before the instrument is up are refused (RST)
EXPERT_ALLOW='Connection reset|Connection finish'
# `ferrofire scpi` reads and sets the controller's tags on 5030
PEER_BIN=target-linux/debug/ferrofire
ZEEK_LOAD=''
ZEEK_REQUIRED=${ZEEK_REQUIRED:-1}
