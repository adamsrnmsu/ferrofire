# bennu-arm64 with the pybennu-power-solver replaced by ferrofire (no Python PYPOWER/scipy needed at runtime).
# Source from images/build.sh like any recipe; FERROFIRE defaults to ~/git/ferrofire. Run deploy/build-overlay.sh first.
NAME=bennu-ferrofire-arm64
RELEASE=jammy
VARIANT=minbase
MIRROR=http://ports.ubuntu.com/ubuntu-ports
PACKAGES=""
SCRIPTS="bennu-arm64.sh ${FERROFIRE:-$HOME/git/ferrofire}/deploy/scripts/ferrofire-power.sh"
OVERLAYS="bennu-arm64 ${SCEPTRE_PHENIX_IMAGES:-$HOME/git/sceptre-phenix-images}/overlays/bennu ${SCEPTRE_PHENIX_IMAGES:-$HOME/git/sceptre-phenix-images}/overlays/brash ${FERROFIRE:-$HOME/git/ferrofire}/deploy/overlays/ferrofire"
SIZE=10G
MINGUI=0
