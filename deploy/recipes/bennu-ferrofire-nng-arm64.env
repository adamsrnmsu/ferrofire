# Same as bennu-ferrofire-arm64, but ferrofire is the nng-only build: the binary links no libzmq (stock bennu, below it, still carries libzmq)
# and speaks NNG REP0/PUB0 only, so scenarios set `transport = nng` in config.ini. Run `CARGO_FLAGS="--no-default-features --features nng" ./build-linux.sh`
# then `deploy/build-overlay.sh nng` first.
# Source from images/build.sh like any recipe; FERROFIRE defaults to ~/git/ferrofire.
NAME=bennu-ferrofire-nng-arm64
RELEASE=jammy
VARIANT=minbase
MIRROR=http://ports.ubuntu.com/ubuntu-ports
PACKAGES=""
SCRIPTS="bennu-arm64.sh ${FERROFIRE:-$HOME/git/ferrofire}/deploy/scripts/ferrofire-power.sh"
OVERLAYS="bennu-arm64 ${SCEPTRE_PHENIX_IMAGES:-$HOME/git/sceptre-phenix-images}/overlays/bennu ${SCEPTRE_PHENIX_IMAGES:-$HOME/git/sceptre-phenix-images}/overlays/brash ${FERROFIRE:-$HOME/git/ferrofire}/deploy/overlays/ferrofire-nng"
SIZE=10G
MINGUI=0
