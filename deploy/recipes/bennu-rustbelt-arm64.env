# bennu-arm64 with the pybennu-power-solver replaced by rustbelt (no Python PYPOWER/scipy needed at runtime).
# Source from images/build.sh like any recipe; RUSTBELT defaults to ~/git/rustbelt. Run deploy/build-overlay.sh first.
NAME=bennu-rustbelt-arm64
RELEASE=jammy
VARIANT=minbase
MIRROR=http://ports.ubuntu.com/ubuntu-ports
PACKAGES=""
SCRIPTS="bennu-arm64.sh ${RUSTBELT:-$HOME/git/rustbelt}/deploy/scripts/rustbelt-power.sh"
OVERLAYS="bennu-arm64 ${SCEPTRE_PHENIX_IMAGES:-$HOME/git/sceptre-phenix-images}/overlays/bennu ${SCEPTRE_PHENIX_IMAGES:-$HOME/git/sceptre-phenix-images}/overlays/brash ${RUSTBELT:-$HOME/git/rustbelt}/deploy/overlays/rustbelt"
SIZE=10G
MINGUI=0
