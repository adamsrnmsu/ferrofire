# ferrofire RTU, arm64. Base: Buildroot configs/qemu_aarch64_virt_defconfig (kernel config, patches).
# UEFI boot (GRUB2 arm64-efi, EFI partition, genimage) follows configs/aarch64_efi_defconfig + board/aarch64-efi.
BR2_aarch64=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches $(BR2_EXTERNAL_FERROFIRE_PATH)/board/ferrofire-rtu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_CCACHE=y

# Toolchain: internal, glibc (dist/ferrofire is built against jammy glibc 2.35 and needs libgcc_s, libm, libc).
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# System: BusyBox init and /bin/sh; root stays read-only (no remount rw in inittab).
BR2_TARGET_GENERIC_HOSTNAME="ferrofire-rtu"
BR2_TARGET_GENERIC_ISSUE="ferrofire RTU"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_FERROFIRE_PATH)/board/ferrofire-rtu/users.table"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FERROFIRE_PATH)/board/ferrofire-rtu/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_FERROFIRE_PATH)/board/ferrofire-rtu/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FERROFIRE_PATH)/board/ferrofire-rtu/post-image.sh"

# Kernel: qemu virt config (virtio blk/net/console, PL011 serial, ACPI) + EFI stub and GPT.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.33"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FERROFIRE_PATH)/board/ferrofire-rtu/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Packages
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_FERROFIRE_PATH)/board/ferrofire-rtu/busybox.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_OPENSSH=y
# seedrng cannot save its seed on a read-only root.
# BR2_PACKAGE_URANDOM_SCRIPTS is not set

# Images: ext4 root (partition 2), GRUB2 EFI, genimage for the GPT disk.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_ARM64_EFI=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
