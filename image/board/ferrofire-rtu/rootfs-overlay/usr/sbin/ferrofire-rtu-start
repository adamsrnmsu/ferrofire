#!/bin/sh
# ferrofire-rtu-start [CONFIG]: run from a phenix startup script (as root). Seeds the firmware and config on the
# data partition once, then keeps `ferrofire watch` running on them. Safe to run any number of times.
set -eu
cfg=${1:-/etc/sceptre/config.xml}
home=/home/sceptre
pidfile=/run/ferrofire-watch.pid

[ -e "$home/ferrofire.firmware" ] || cp /usr/bin/ferrofire "$home/ferrofire.firmware"
[ -e "$home/config.xml" ] || cp "$cfg" "$home/config.xml"
chown sceptre:sceptre "$home/ferrofire.firmware" "$home/config.xml"

if [ -r "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
	exit 0
fi
nohup /usr/bin/ferrofire watch --firmware "$home/ferrofire.firmware" --file "$home/config.xml" \
	>/dev/null 2>>/var/log/ferrofire-watch.log </dev/null &
echo $! >"$pidfile"
