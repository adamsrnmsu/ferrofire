CONFIG_TELNETD=y
CONFIG_FEATURE_TELNETD_STANDALONE=y
CONFIG_NTPD=y
CONFIG_BASE64=y
CONFIG_SHA256SUM=y
# su, login: root's empty password works only on the ttys in /etc/securetty (console, ttyAMA0), never over the network.
CONFIG_FEATURE_SECURETTY=y
CONFIG_FEATURE_SU_BLANK_PW_NEEDS_SECURE_TTY=y
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_VOLUMEID=y
CONFIG_FEATURE_VOLUMEID_EXT=y
CONFIG_NC=y
