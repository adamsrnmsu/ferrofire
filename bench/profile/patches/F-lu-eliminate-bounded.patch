+    let hi = (k..n).rev().find(|&j| pivot_row[j] != 0.0).map_or(k, |j| j + 1);
+    let prow = &pivot_row[k..hi];
+    let pkk = pivot_row[k];
+    for (r, row) in rest.chunks_exact_mut(n).enumerate() {
+        let f = row[k] / pkk;
         if f == 0.0 {
             continue;
