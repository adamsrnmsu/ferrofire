+/// FNV-1a: the tag names come from the model, not from a peer, so SipHash's flood resistance buys nothing here.
+#[derive(Default)]
+struct Fnv(u64);
+impl std::hash::Hasher for Fnv {
+    fn finish(&self) -> u64 {
+        self.0
+    }
+    fn write(&mut self, b: &[u8]) {
+        let mut h = if self.0 == 0 { 0xcbf29ce484222325 } else { self.0 };
+        for x in b {
+            h = (h ^ u64::from(*x)).wrapping_mul(0x100000001b3);
+        }
+        self.0 = h;
+    }
+}
